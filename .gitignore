# 本仓库只跟踪 characters/sun-bo/maestro/（总谱）
# 其余写作工作区内容保留在本地，不纳入版本管理

# 默认忽略根目录下一切
/*

# 放行 .gitignore 本身
!/.gitignore

# 逐层放行到 maestro（git 必须逐级进入目录）
!/characters/
/characters/*
!/characters/sun-bo/
/characters/sun-bo/*
!/characters/sun-bo/maestro/

# 编辑器与系统杂项
.obsidian/
.crossnote/
.DS_Store
Thumbs.db
*.tmp
*.log
