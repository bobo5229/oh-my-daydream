---
import ReaderLayout from '../layouts/ReaderLayout.astro';
import ReaderNav from './ReaderNav.astro';
import Icon from './Icon.astro';
import { loadReaderContent, assertUsableContent } from '../content/index.ts';
import { loadReadingOrder } from '../metadata/reading-order.ts';
interface Props { autoResume?: boolean }
const { autoResume = false } = Astro.props;
const content = await loadReaderContent();
assertUsableContent(content);
const chapters = content.chapters.map(({ id, title, ordinal }) => ({ id, title, ordinal }));
const order = await loadReadingOrder(content);
---
<ReaderLayout title="作品首页">
  <ReaderNav slot="navigation" chapters={chapters} />
  <section class="home-page" data-home data-auto-resume={String(autoResume)} data-chapters={JSON.stringify(chapters)} data-chronicle-start={order.chronicle[0]?.url}>
    <h1 class="work-title">总谱</h1>
    <p class="home-meta">共 {chapters.length} 章</p>
    <div class="home-actions">
      {chapters[0] && <a class="primary-link" href={`/read/${chapters[0].id}/`} data-start-reading><span data-start-label>开始阅读</span><Icon name="right" /></a>}
      <a href="/contents/">浏览章节目录</a>
      <a href="/gallery/">视觉资料库</a>
    </div>
    <p class="resume-title muted" data-resume-title hidden></p>
  </section>
  <script>import '../client/home.ts';</script>
</ReaderLayout>
