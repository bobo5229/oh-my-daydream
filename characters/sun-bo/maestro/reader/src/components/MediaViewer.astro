---
import Icon from './Icon.astro';
---
<dialog id="media-viewer" class="media-viewer" aria-labelledby="media-title">
  <header class="media-toolbar">
    <h2 id="media-title">图片预览</h2>
    <div class="media-controls">
      <button class="icon-button" type="button" data-zoom-out aria-label="缩小图片"><Icon name="minus" /></button>
      <output data-zoom-label aria-live="polite">100%</output>
      <button class="icon-button" type="button" data-zoom-in aria-label="放大图片"><Icon name="plus" /></button>
      <button class="icon-button" type="button" data-fit-image aria-label="适合窗口"><Icon name="fit" /></button>
      <button class="icon-button" type="button" data-close-media aria-label="关闭图片预览"><Icon name="close" /></button>
    </div>
  </header>
  <div class="media-stage" data-media-stage tabindex="0" role="group" aria-label="图片画布，可缩放并用方向键平移"><p class="media-status" data-media-status role="status">正在载入图片…</p></div>
  <p class="media-help">滚轮或双指缩放 · 拖动或方向键平移 · 0 适合窗口 · Esc 关闭</p>
</dialog>
<script>import '../client/media-viewer.ts';</script>
