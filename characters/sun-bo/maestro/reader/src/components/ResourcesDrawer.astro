---
import Icon from './Icon.astro';
import InterludeText from './InterludeText.astro';
import ExpandedReader from './ExpandedReader.astro';
import LoreBrowser from './LoreBrowser.astro';
import type { LoreIndex } from '../metadata/lore.ts';
import type { AssetIndex } from '../metadata/assets.ts';
import type { Timeline } from '../metadata/timeline.ts';
import type { Interlude } from '../content/types.ts';
interface Props { timeline: Timeline; interludes: Interlude[]; chapterId: string; blockIds: string[]; lore: LoreIndex; relatedEntityIds: string[]; assets: AssetIndex; contextByChapter?: Record<string, string[]> }
const { timeline, interludes, chapterId, blockIds, lore, relatedEntityIds, assets, contextByChapter = {} } = Astro.props;
const unlinked = interludes.filter(item => !timeline.interludes.find(link => link.interludeId === item.id)?.stageIds.length);
const data = { stages: timeline.stages, chapters: timeline.chapters, chapterId, blockIds };
---
<dialog id="resources-drawer" class="resources-drawer" aria-labelledby="resources-title">
  <div class="drawer-heading">
    <h2 id="resources-title">资料</h2>
    <button class="icon-button" type="button" data-close-resources aria-label="关闭资料抽屉"><Icon name="close" /></button>
  </div>
  <div class="resource-tabs" role="tablist" aria-label="资料类型"><button id="resource-tab-timeline" type="button" role="tab" aria-controls="resource-panel-timeline" aria-selected="true" data-resource-tab="timeline">行业编年</button><button id="resource-tab-lore" type="button" role="tab" aria-controls="resource-panel-lore" aria-selected="false" tabindex="-1" data-resource-tab="lore">Lore</button></div>
  <section id="resource-panel-timeline" role="tabpanel" aria-labelledby="resource-tab-timeline" data-resource-panel="timeline">
  <div class="story-follow">
    <p class="eyebrow">当前故事时间</p>
    <p data-current-story-stage></p>
    <p class="muted follow-status" data-follow-status role="status">正在跟随正文</p>
    <button class="text-button" type="button" data-resume-follow hidden>返回当前故事时间</button>
  </div>
  <nav class="timeline-list" aria-label="行业编年时间线">
    {timeline.stages.map(stage => <details data-stage-group={stage.id}>
      <summary>{stage.label}</summary>
      <div class="stage-entries">
        {timeline.interludes.filter(link => link.stageIds.includes(stage.id)).map(link => {
          const interlude = interludes.find(item => item.id === link.interludeId)!;
          return <button class="timeline-entry" type="button" data-select-interlude={interlude.id}><span>Interlude {interlude.number}</span><small>{link.eventPeriod}</small></button>;
        })}
        {!timeline.interludes.some(link => link.stageIds.includes(stage.id)) && <p class="empty-note">本阶段暂无关联档案</p>}
      </div>
    </details>)}
    {unlinked.length > 0 && <details data-unlinked-interludes><summary>未关联档案</summary><div class="stage-entries">{unlinked.map(interlude => <button class="timeline-entry" type="button" data-select-interlude={interlude.id}>{interlude.title}</button>)}</div></details>}
    {interludes.length === 0 && <p class="empty-note">尚无行业编年档案</p>}
  </nav>
  <section class="selected-interlude" data-resource-selection data-interlude-selection hidden>
    <div class="resource-article-tools"><h3>档案全文</h3><button class="quiet-button" type="button" data-expand-resource aria-label="展开档案独立阅读"><Icon name="expand" />展开</button></div>
    <div data-resource-home>{interludes.map(interlude => <InterludeText interlude={interlude} hidden inDrawer />)}</div>
  </section>
  </section>
  <section id="resource-panel-lore" role="tabpanel" aria-labelledby="resource-tab-lore" data-resource-panel="lore" hidden><LoreBrowser lore={lore} relatedIds={relatedEntityIds} assets={assets} contextByChapter={contextByChapter} /></section>
</dialog>
<ExpandedReader />
<script type="application/json" id="reader-timeline" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
<script>import '../client/resources.ts';</script>
