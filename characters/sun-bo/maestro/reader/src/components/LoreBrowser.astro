---
import { ENTITY_TYPES } from '../metadata/lore.ts';
import LoreSourceView from './LoreSourceView.astro';
import Icon from './Icon.astro';
import AssetFigure from './AssetFigure.astro';
import type { AssetIndex } from '../metadata/assets.ts';
import type { LoreIndex } from '../metadata/lore.ts';
interface Props { lore: LoreIndex; relatedIds: string[]; assets: AssetIndex; contextByChapter: Record<string, string[]> }
const { lore, relatedIds, assets, contextByChapter } = Astro.props;
---
<div data-lore-browser data-related-entity-ids={JSON.stringify(relatedIds)} data-chapter-entity-ids={JSON.stringify(contextByChapter)}>
  <div data-lore-browse>
  <div class="scope-buttons" role="group" aria-label="资料范围"><button type="button" data-lore-scope="context" aria-pressed="true">本章相关</button><button type="button" data-lore-scope="all" aria-pressed="false">全部资料</button></div>
  <label class="field-label" for="lore-search">搜索 Lore</label>
  <input id="lore-search" class="search-input" type="search" placeholder="名称或别称" autocomplete="off" data-lore-search />
  <label class="field-label" for="lore-category">资料类别</label>
  <select class="filter-select" id="lore-category" data-lore-category><option value="all">全部类别</option>{Object.entries(ENTITY_TYPES).map(([key, label]) => <option value={key}>{label}</option>)}</select>
  <p class="result-count muted" data-lore-results-count role="status"></p>
  <ul class="entity-results" data-lore-results>{lore.entities.map(entity => <li data-entity-result={entity.id}><button type="button" data-open-entity={entity.id}><span>{entity.name}</span><small>{ENTITY_TYPES[entity.type]}</small></button></li>)}</ul>
  <p class="empty-note" data-lore-empty hidden>没有找到匹配条目，可更换名称、别称或类别。</p>
  </div>
  <section class="lore-detail" data-resource-selection data-lore-detail hidden>
    <button class="text-button" type="button" data-lore-back>返回列表</button>
    <h3 data-entity-title tabindex="-1"></h3>
    <p class="eyebrow" data-entity-type></p>
    <p class="entity-aliases muted" data-entity-aliases></p>
    <div data-entity-media>{assets.assets.filter(asset => asset.entityIds.length).map(asset => <div data-entity-asset data-entity-owners={JSON.stringify(asset.entityIds)} hidden><AssetFigure asset={asset} /></div>)}</div>
    <p class="eyebrow">资料摘录</p><p class="entity-summary" data-entity-summary></p>
    <dl class="entity-properties" data-entity-properties></dl>
    <p class="source-credit" data-entity-source></p>
    <details class="full-source" data-lore-full><summary>查看完整来源资料</summary>
      <div class="resource-article-tools"><span class="muted">原资料全文</span><button class="quiet-button" type="button" data-expand-resource aria-label="展开完整资料独立阅读"><Icon name="expand" />展开</button></div>
      <div data-resource-home>{lore.sources.map(source => <LoreSourceView source={source} hidden />)}</div>
    </details>
    <div data-entity-relations><h4>相关条目</h4><ul class="entity-results" data-related-entities></ul></div>
  </section>
</div>
<script type="application/json" id="reader-entities" set:html={JSON.stringify({ entities: lore.entities, sources: lore.sources.map(({ id, file, heading }) => ({ id, file, heading })) }).replace(/</g, '\\u003c')} />
<script>import '../client/lore.ts';</script>
