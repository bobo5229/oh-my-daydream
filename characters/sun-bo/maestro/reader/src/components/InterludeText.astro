---
import type { Interlude } from '../content/types.ts';
interface Props { interlude: Interlude; hidden?: boolean; inDrawer?: boolean; omitRepeatedTitle?: boolean }
const { interlude, hidden = false, inDrawer = false, omitRepeatedTitle = false } = Astro.props;
let html = inDrawer ? interlude.html.replace(/\bid="(i-interlude-[^"]+)"/g, 'id="drawer-$1"').replace(/\bhref="#(i-interlude-[^"]+)"/g, 'href="#drawer-$1"') : interlude.html;
// 独立路由已经以 H1 展示原题；保留同一段内的副标题与稳定锚点。
if (omitRepeatedTitle) html = html.replace(/^(<p\b[^>]*>)<strong>[\s\S]*?<\/strong>\s*/, '$1');
---
<div class="novel resource-prose" data-resource-text data-interlude-id={interlude.id} aria-label={interlude.title} hidden={hidden}>
  <Fragment set:html={html} />
</div>
