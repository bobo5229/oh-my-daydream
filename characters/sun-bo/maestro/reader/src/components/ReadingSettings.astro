---
import Icon from './Icon.astro';
import { DEFAULT_PREFERENCES, FONT_SIZE_LIMITS, LINE_HEIGHT_LIMITS } from '../client/preferences-model.ts';
---
<details class="reading-settings" data-reading-settings>
  <summary class="quiet-button" aria-label="阅读设置"><Icon name="settings" /><span class="settings-label">设置</span></summary>
  <div class="settings-panel">
    <h2>阅读设置</h2>
    <label for="reading-theme">主题</label>
    <select id="reading-theme" data-theme-preference>
      <option value="system">跟随系统</option>
      <option value="light">浅色</option>
      <option value="dark">深色</option>
    </select>
    <label class="range-label" for="reading-font-size">字号 <output data-font-size-value for="reading-font-size">18px</output></label>
    <input id="reading-font-size" aria-label="字号" data-font-size type="range" min={FONT_SIZE_LIMITS.min} max={FONT_SIZE_LIMITS.max} step={FONT_SIZE_LIMITS.step} value={DEFAULT_PREFERENCES.fontSize} />
    <label class="range-label" for="reading-line-height">行距 <output data-line-height-value for="reading-line-height">1.85</output></label>
    <input id="reading-line-height" aria-label="行距" data-line-height type="range" min={LINE_HEIGHT_LIMITS.min} max={LINE_HEIGHT_LIMITS.max} step={LINE_HEIGHT_LIMITS.step} value={DEFAULT_PREFERENCES.lineHeight} />
    <button class="quiet-button reset-typography" type="button" data-reset-typography>恢复默认排版</button>
  </div>
</details>
<script>
  import '../client/settings.ts';
</script>
