---
import ReaderLayout from '../layouts/ReaderLayout.astro';
import ReaderNav from '../components/ReaderNav.astro';
import { loadReaderContent, assertUsableContent } from '../content/index.ts';
import { loadReadingOrder } from '../metadata/reading-order.ts';
const content = await loadReaderContent();
assertUsableContent(content);
const chapters = content.chapters.map(({ id, title, ordinal }) => ({ id, title, ordinal }));
const order = await loadReadingOrder(content);
---
<ReaderLayout title="章节目录">
  <ReaderNav slot="navigation" chapters={chapters} />
  <section class="contents-page">
    <h1 class="chapter-title">章节目录</h1>
    <p class="muted">共 {chapters.length} 章</p>
    <ol class="chapter-list full-contents" data-mode-directory="novel">
      {chapters.map(chapter => <li><a href={`/read/${chapter.id}/`}>{chapter.title}</a></li>)}
    </ol>
    <ol class="chapter-list full-contents" data-mode-directory="chronicle" hidden>{order.chronicle.map(node => <li><a href={node.url} data-reading-node={node.id}>{node.title}</a></li>)}</ol>
  </section>
</ReaderLayout>
