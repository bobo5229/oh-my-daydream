---
import ReaderLayout from '../../layouts/ReaderLayout.astro';
import ReaderNav from '../../components/ReaderNav.astro';
import InterludeText from '../../components/InterludeText.astro';
import ChapterPager from '../../components/ChapterPager.astro';
import { loadPresentation } from '../../presentation.ts';
import ResourcesDrawer from '../../components/ResourcesDrawer.astro';
import Icon from '../../components/Icon.astro';
import type { Interlude } from '../../content/types.ts';
export async function getStaticPaths() {
  const bundle = await loadPresentation();
  const { content } = bundle;
  const chapters = content.chapters.map(({ id, title, ordinal }) => ({ id, title, ordinal }));
  return content.interludes.map(interlude => ({ params: { interlude: interlude.id }, props: { interlude, chapters, bundle } }));
}
interface Props { bundle: Awaited<ReturnType<typeof loadPresentation>>; interlude: Interlude; chapters: { id: string; title: string; ordinal: number }[] }
const { interlude, chapters, bundle } = Astro.props;
---
<ReaderLayout title={interlude.title}>
  <ReaderNav slot="navigation" chapters={chapters}><button class="quiet-button resources-opener" type="button" data-open-resources aria-label="打开资料抽屉" aria-controls="resources-drawer" aria-haspopup="dialog"><Icon name="archive" /><span>资料</span></button></ReaderNav>
  <div class="formal-interlude" data-formal-interlude-id={interlude.id} data-source-chapter={interlude.chapterId}>
    <h1 class="chapter-title">{interlude.title}</h1>
    <InterludeText interlude={interlude} omitRepeatedTitle />
    <p class="return-to-novel"><a href={`/read/${interlude.chapterId}/`} data-return-to-novel>返回正文原位置</a></p>
    <ChapterPager />
  </div>
<ResourcesDrawer timeline={bundle.timeline} interludes={bundle.content.interludes} chapterId={interlude.chapterId} blockIds={bundle.content.chapters.find(chapter => chapter.id === interlude.chapterId)!.novel.blocks.map(block => block.id)} lore={bundle.lore} relatedEntityIds={bundle.associations.chapters.find(item => item.chapterId === interlude.chapterId)?.entityIds ?? []} assets={bundle.assets} contextByChapter={Object.fromEntries(bundle.associations.chapters.map(item => [item.chapterId, item.entityIds]))} />
</ReaderLayout>
