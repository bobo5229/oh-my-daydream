---
import ReaderLayout from '../layouts/ReaderLayout.astro';
import ReaderNav from '../components/ReaderNav.astro';
import AssetFigure from '../components/AssetFigure.astro';
import { loadReaderContent } from '../content/index.ts';
import { loadLore } from '../metadata/lore.ts';
import { loadAssets, ASSET_TYPES } from '../metadata/assets.ts';
const content = await loadReaderContent();
const lore = await loadLore();
const assets = await loadAssets(content, lore);
const chapters = content.chapters.map(({ id, title, ordinal }) => ({ id, title, ordinal }));
---
<ReaderLayout title="视觉资料库">
  <ReaderNav slot="navigation" chapters={chapters} />
  <section data-gallery>
    <h1 class="chapter-title">视觉资料库</h1>
    <div class="gallery-filters"><div><label class="field-label" for="gallery-search">搜索视觉资料</label><input id="gallery-search" class="search-input" type="search" placeholder="名称或说明" data-gallery-search /></div><div><label class="field-label" for="gallery-category">图像类型</label><select id="gallery-category" class="filter-select" data-gallery-category><option value="all">全部类型</option>{Object.entries(ASSET_TYPES).map(([key, label]) => <option value={key}>{label}</option>)}</select></div></div>
    <p class="result-count muted" data-gallery-count role="status">{assets.assets.length} 项资料</p>
    <ul class="gallery-list">{assets.assets.map(asset => <li data-gallery-asset={asset.id} data-asset-type={asset.type} data-asset-search={`${asset.alt} ${asset.caption}`}>
      <AssetFigure asset={asset} /><h2>{asset.alt}</h2><p class="eyebrow">{ASSET_TYPES[asset.type]}</p>
      <div class="asset-relations">{asset.entityIds.map(id => { const entity = lore.entities.find(entity => entity.id === id); return entity && <a href={`/lore/${id}/`}>{entity.name}</a>; })}{asset.chapterIds.map(id => <a href={`/read/${id}/`}>{chapters.find(chapter => chapter.id === id)?.title}</a>)}{asset.interludeIds.map(id => <a href={`/interlude/${id}/`}>{content.interludes.find(interlude => interlude.id === id)?.title}</a>)}</div>
    </li>)}</ul>
    <div class="gallery-empty" data-gallery-empty hidden={assets.assets.length > 0}><h2>{assets.assets.length ? '没有匹配的视觉资料' : '尚无视觉资料'}</h2><p class="muted">{assets.assets.length ? '可换个名称或图像类型继续查找。' : '添加已确认的人物、场景、Logo 或图表后，会在这里汇集。'}</p><a href={`/read/${chapters[0]?.id}/`} data-return-to-novel>返回正文原位置</a></div>
  </section>
  <script>import '../client/gallery.ts';</script>
</ReaderLayout>
